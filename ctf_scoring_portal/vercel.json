{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "templates/**,static/**,public/**"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/public/(.*)",
      "destination": "/public/$1"
    },
    {
      "source": "/css/(.*)",
      "destination": "/public/css/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index?path=/$1"
    }
  ]
}
